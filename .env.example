# ── MongoDB Atlas ──
# Atlas → Cluster → Connect → Drivers → copy the connection string.
# Create a DB user under Security → Database Access, then fill in user:password.
# Add "/TAIFY" before the "?" to name the database.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.6jhidu5.mongodb.net/TAIFY?appName=Cluster0

# ── Team dashboard auth (required for /admin and /seoteam) ──
# The single shared password your team types to sign in.
SEO_DASHBOARD_PASSWORD=change-me-to-something-strong
# A long random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-64-char-random-hex-string

# ── Image uploads (Vercel Blob) ──
# In Vercel: Storage → Create → Blob → connect to the project. Vercel injects this
# automatically on deploy. For local dev, copy it from the store's settings.
BLOB_READ_WRITE_TOKEN=

# ── SEO ──
# Canonical site URL used for sitemap, canonical tags, and Open Graph.
# Leave this UNSET in production: src/lib/site.ts hard-codes the canonical
# domain (https://www.thereisanaiforyou.com) and ignores any *.vercel.app
# value, so a preview host can never become the canonical domain again.
# Only set it when serving the site from a different real domain.
# NEXT_PUBLIC_SITE_URL=https://www.thereisanaiforyou.com

# ── Anthropic (optional — AI match uses a mock fallback until this is set) ──
ANTHROPIC_API_KEY=
# Model for AI tool-matching. Haiku is cheapest; try claude-sonnet-5 for quality.
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Owner lead notifications (SMTP) ──
# Emails the owners whenever the public /submit form captures a tool listing.
# Sent from our own mailbox over SMTP — no third-party sending service.
# Leave SMTP_USER/SMTP_PASS blank to disable: sending becomes a clean no-op and
# submissions still save normally.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS. If the host blocks egress on 465 (ETIMEDOUT / ESOCKET),
# switch to 587, which STARTTLSes on the same credentials.
SMTP_PORT=465
SMTP_USER=
# A 16-character Google App Password, NOT the account login password, which is
# rejected with a 535. Requires 2-Step Verification on the account. Google shows
# it in four blocks of four; the spaces are stripped automatically.
SMTP_PASS=
# Gmail silently rewrites From unless it matches the authenticated account or a
# verified "send mail as" alias — so keep this equal to SMTP_USER.
EMAIL_FROM=
# Comma-separated; every address listed is copied on every notification.
LEADS_NOTIFY_EMAIL=
# Diagnostics for the above, admin-only: GET /api/admin/email-test reports the
# config and authenticates without sending; POST sends one real test message.
